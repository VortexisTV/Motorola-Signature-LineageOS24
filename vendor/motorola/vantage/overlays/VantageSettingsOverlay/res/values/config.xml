<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings > Display > "Maximum refresh rate" and "Minimum refresh rate" (LineageOS's
         PeakRefreshRateListPreferenceController and MinRefreshRatePreferenceController). Both
         lists are built from the display's own modes: on this panel 165, 120, 90, 60, 30 and
         24 Hz (1264 x 2780).

         The 165 Hz mode is a mode group of its own (no seamless switch to the other rates), and
         Android 17 keeps the display in the default mode's group (120 Hz, with 60/30/24). So
         165 Hz is all or nothing: set Maximum to 165 Hz, then Minimum to 165 Hz. The maximum
         setting outranks the minimum one, so Minimum alone has no effect while Maximum is
         120 Hz (the stock default, from the stock /vendor overlay). Battery saver and thermal
         limits still lower the rate. -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <bool name="config_show_min_refresh_rate_switch">true</bool>
</resources>
