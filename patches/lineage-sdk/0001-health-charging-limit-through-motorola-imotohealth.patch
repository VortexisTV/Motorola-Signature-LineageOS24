@@ -0,0 +1,132 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.health;
+
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Log;
+
+import vendor.lineage.health.ChargingControlSupportedMode;
+import vendor.lineage.health.ChargingLimitInfo;
+import vendor.lineage.health.IChargingControl;
+
+/**
+ * Charging control through Motorola's vendor HAL, for a generic system image on a Motorola
+ * device whose stock vendor has no vendor.lineage.health HAL.
+ *
+ * motorola.hardware.health.IMotoHealth/default (stock vendor, AIDL V3) has
+ * setChgLimits(lower, upper): the vendor service writes the two values to the kernel's
+ * adaptive-charge thresholds, so charging stops at "upper" percent and starts again at "lower".
+ * It accepts an upper limit of 1..100 and a lower limit below it; a negative upper limit turns
+ * the thresholds off (-1, the value the kernel starts with). Stock calls it from system_server
+ * (BatteryService), so the stock vendor's SELinux policy lets system_server reach it.
+ *
+ * Only LIMIT mode is offered. LineageOS's "no limit" (max 100, min 0) is sent as "off": a real
+ * 100 % threshold would only start charging again at 0 %.
+ */
+final class MotoChargingControl extends IChargingControl.Default {
+    private static final String TAG = "MotoChargingControl";
+
+    static final String SERVICE = "motorola.hardware.health.IMotoHealth/default";
+    private static final String DESCRIPTOR = "motorola.hardware.health.IMotoHealth";
+
+    // Transaction codes of IMotoHealth V3, as in the stock framework's generated proxy.
+    private static final int TRANSACTION_SET_CHG_LIMITS = IBinder.FIRST_CALL_TRANSACTION + 1;
+    private static final int TRANSACTION_GET_CHG_DISABLED = IBinder.FIRST_CALL_TRANSACTION + 2;
+
+    private static final int LIMIT_OFF = -1;
+
+    private final IBinder mHal;
+    private ChargingLimitInfo mLimit; // last limit that was set; null until then
+
+    private MotoChargingControl(IBinder hal) {
+        mHal = hal;
+    }
+
+    /** The adapter, or null when the device does not declare Motorola's health HAL. */
+    static IChargingControl get() {
+        if (!ServiceManager.isDeclared(SERVICE)) {
+            return null;
+        }
+        IBinder hal = ServiceManager.waitForDeclaredService(SERVICE);
+        if (hal == null) {
+            Log.e(TAG, SERVICE + " is declared but not available");
+            return null;
+        }
+        Log.i(TAG, "Charging control through " + SERVICE + " (limit mode)");
+        return new MotoChargingControl(hal);
+    }
+
+    @Override
+    public int getSupportedMode() {
+        return ChargingControlSupportedMode.LIMIT;
+    }
+
+    @Override
+    public ChargingLimitInfo getChargingLimit() {
+        ChargingLimitInfo info = new ChargingLimitInfo();
+        // Unknown until the first set: report a value no caller asks for, so the first
+        // request is always sent (the kernel starts without thresholds after every boot).
+        info.max = mLimit != null ? mLimit.max : LIMIT_OFF;
+        info.min = mLimit != null ? mLimit.min : LIMIT_OFF;
+        return info;
+    }
+
+    @Override
+    public void setChargingLimit(ChargingLimitInfo limit) throws RemoteException {
+        int upper = limit.max;
+        int lower = limit.min;
+        if (upper >= 100 || upper <= 0) {
+            upper = LIMIT_OFF;
+            lower = LIMIT_OFF;
+        } else {
+            lower = Math.max(0, Math.min(lower, upper - 1));
+        }
+        int result = call(TRANSACTION_SET_CHG_LIMITS, lower, upper);
+        if (result != 0) {
+            throw new RemoteException("setChgLimits(" + lower + ", " + upper + ") failed: " + result);
+        }
+        Log.i(TAG, "Charging thresholds set: stop at " + upper + "%, resume at " + lower + "%");
+        mLimit = new ChargingLimitInfo();
+        mLimit.max = limit.max;
+        mLimit.min = limit.min;
+    }
+
+    @Override
+    public boolean getChargingEnabled() throws RemoteException {
+        return call(TRANSACTION_GET_CHG_DISABLED) == 0;
+    }
+
+    @Override
+    public void setChargingEnabled(boolean enabled) {
+        Log.w(TAG, "setChargingEnabled is not supported");
+    }
+
+    @Override
+    public void setChargingDeadline(long deadline) {
+        Log.w(TAG, "setChargingDeadline is not supported");
+    }
+
+    private int call(int code, int... args) throws RemoteException {
+        Parcel data = Parcel.obtain(mHal);
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            for (int a : args) {
+                data.writeInt(a);
+            }
+            if (!mHal.transact(code, data, reply, 0)) {
+                throw new RemoteException("IMotoHealth transaction " + code + " not implemented");
+            }
+            reply.readException();
+            return reply.readInt();
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+}
