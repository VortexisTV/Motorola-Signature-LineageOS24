+    @Override
+    protected boolean onBatteryChanged(float batteryPct, long startTime, long targetTime,
+            int configMode) {
+        if (configMode != MODE_AUTO && configMode != MODE_MANUAL) {
+            Log.e(TAG, "Possible bug: onBatteryChanged called with unsupported mode: " + configMode);
+            return false;
+        }
+        final long now = System.currentTimeMillis();
+        // Time to full as Android estimates it while charging near the hold level; the
+        // estimate is not available once charging has stopped there, so the last one is kept.
+        BatteryManager bm = mContext.getSystemService(BatteryManager.class);
+        long estimate = bm != null ? bm.computeChargeTimeRemaining() : -1;
+        if (estimate > 0 && batteryPct >= HOLD_LEVEL - mChargingLimitMargin) {
+            mTimeToFullMs = estimate;
+        }
+        long timeToFull = (mTimeToFullMs > 0 ? mTimeToFullMs : FALLBACK_TIME_TO_FULL_MS)
+                + mChargingTimeMargin;
+        boolean hold = now >= startTime && targetTime - now > timeToFull;
+        Log.i(TAG, "Battery " + batteryPct + "%, " + (targetTime - now) / 60000 + " min to target, "
+                + "time to full " + timeToFull / 60000 + " min: " + (hold ? "hold at " + HOLD_LEVEL
+                + "%" : "no limit"));
+        setChargingLimit(hold ? HOLD_LEVEL : 100);
+        return hold;
+    }
